OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Host LLM proxy. Use 127.0.0.1 when running the API directly and
# host.docker.internal when running the API in Docker.
OPENAI_MODEL=gpt-4o
PERSON_AGENTS_GRANTED_PERMISSIONS=read,write
PERSON_AGENTS_API_KEY_HASH=
PERSON_AGENTS_DEFAULT_TENANT_ID=default
PERSON_AGENTS_REDIS_URL=
PERSON_AGENTS_POSTGRES_DSN=
PERSON_AGENTS_ADMIN_API_KEY_HASH=
PERSON_AGENTS_TENANT_MAX_RUNNING_RUNS=3
PERSON_AGENTS_TENANT_DAILY_RUN_LIMIT=1000
PERSON_AGENTS_TENANT_DAILY_TOKEN_LIMIT=1000000
PERSON_AGENTS_TENANT_DAILY_COST_LIMIT=10.0
PERSON_AGENTS_RUN_MAX_ATTEMPTS=3
PERSON_AGENTS_RUN_RETRY_BACKOFF_SECONDS=30
PERSON_AGENTS_AGENT_VERSION=0.1.0
PERSON_AGENTS_PROMPT_VERSION=default-v1
PERSON_AGENTS_TOOL_CONFIG_VERSION=default-v1
PERSON_AGENTS_POLICY_VERSION=default-v1
OLLAMA_BASE_URL=http://localhost:11434
LLM_RELAY_PORT=18788
LLM_RELAY_TARGET=127.0.0.1
LLM_RELAY_TARGET_PORT=8788
LOG_LEVEL=INFO
LOG_FORMAT=console
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
GRAFANA_ADMIN_PASSWORD=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_S3_ACCESS_KEY_ID=
LANGFUSE_S3_SECRET_ACCESS_KEY=
API_KEY_HASH=
ADMIN_API_KEY_HASH=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
